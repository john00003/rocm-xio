# docker/rocm-xio-kv-ceph/.env.example
# Copy to .env and edit, or pass with `docker run --env-file`.
# Defaults reproduce the verified configuration in docs/ROCXIO_CONFIG_MATRIX.md.

# ---- Host data dir (bind-mounted to /data). Set on `docker run -v` (see README). ----
# DATA_DIR is the HOST path; the container always sees /data.

# ---- VM tooling source (upstream default; override block below for full GPU pass) ----
QEMU_MINIMAL_REMOTE=https://github.com/sbates130272/qemu-minimal
QEMU_MINIMAL_BRANCH=master
GENVM_SCRIPT=qemu/gen-vm
RUNVM_SCRIPT=qemu/run-vm

# ---- RECOMMENDED OVERRIDE: the fork carrying the tuned run-vm-modified (full GPU pass) ----
# QEMU_MINIMAL_REMOTE=https://github.com/john00003/qemu-minimal
# QEMU_MINIMAL_BRANCH=users/john00003/john-modifications
# RUNVM_SCRIPT=qemu/run-vm-modified
# (If the fork is private, mount an SSH key: see README "Private fork clone".)

# ---- Guest provisioning (Ansible) source ----
ANSIBLE_REMOTE=https://github.com/john00003/batesste-ansible
ANSIBLE_BRANCH=users/john00003/rocm-xio-kv-docker
ANSIBLE_PLAYBOOK=playbooks/rocm-xio-kv-guest.yml
ANSIBLE_INVENTORY=playbooks/rocm-xio-kv-hosts.yml

# ---- Hardware (MUST match your host for GPU E2E) ----
GPU_BDFS=0000:0c:00.0,0000:0c:00.1
NVME_BDF=0000:04:00.0          # NEVER 0000:01:00.0 (host root disk) -- guard.sh refuses it
SSH_PORT=2223                  # never 2222
VCPUS=8
VMEM=15360
NVME=2
IOMMU=disable
PCI_MMIO_BRIDGE=enable
VM_NAME=kv-ceph-vm
VRAM_DEV_INDEX=2               # 1-based index into PCI_HOSTDEV (NVMe-first -> 2 = GPU). Order-sensitive.
VRAM_BAR=0

# ---- Guest test knobs ----
ROCXIO_NVME_DEVICE=/dev/disk/by-id/nvme-Samsung_SSD_980_PRO_2TB_S6B0NC0RA03709B
USE_PCI_MMIO_BRIDGE=1
TASKSET_CPUS=0-4
CTEST_LABEL_EXCLUDE=rdma

# ---- Component pins (build-time; change requires image rebuild) ----
SPDK_REMOTE=https://github.com/mmgaggle/spdk
SPDK_BRANCH=rados-nkv
ROCM_XIO_REMOTE=https://github.com/mmgaggle/rocm-xio
ROCM_XIO_BRANCH=nvme-kv
